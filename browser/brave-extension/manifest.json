{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.1.0",
  "description": "Cotizaciones públicas y sincronización opcional de cartera a GitHub privado, sin operar.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
