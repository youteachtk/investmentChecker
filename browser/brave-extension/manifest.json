{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.8.24",
  "description": "2.8.24: Movimientos reales paginados y órdenes programadas leídas por separado, sin enviar operaciones.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://www.retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
