{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.8.0",
  "description": "Prepara lotes de compras virtuales con límites, aprobación explícita y revisión de la interfaz real. No envía operaciones sin adaptador verificado.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://www.retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
