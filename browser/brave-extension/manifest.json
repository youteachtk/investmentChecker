{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.2.3",
  "description": "Identifica ETFs por catálogo completo sin exigir AAXJ en primera fila; reintenta cambio de categoría y sincroniza cartera privada.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
