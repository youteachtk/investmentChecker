{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.7.1",
  "description": "Evita Frame with ID 0 was removed al terminar cotizaciones: cierra la pestaña temporal después del script y recupera recargas de Brave.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://www.retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
