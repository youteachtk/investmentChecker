{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.5.1",
  "description": "Corrige Tu inversión con ruta directa o submenú Angular; lee saldos adyacentes y registra la etapa exacta del fallo privado.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
