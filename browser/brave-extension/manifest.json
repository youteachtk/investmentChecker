{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.8.9",
  "description": "2.8.9: inspector compatible con panel lateral derecho de Capitales; conserva búsqueda de V y sin envíos de compras.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://www.retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
