{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.8.2",
  "description": "Confirma al instante el arranque y muestra apertura/carga de Capitales, progreso 0–226 y errores de inicio sin espera indefinida.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://www.retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
