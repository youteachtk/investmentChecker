{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.8.3",
  "description": "Recupera la sincronización cuando Brave no responde al botón: activación inmediata más alarma, sin duplicar lecturas y con diagnóstico de arranque.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://www.retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
