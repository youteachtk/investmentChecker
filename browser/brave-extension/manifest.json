{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.5.0",
  "description": "Captura pública 226/226 intacta; navegación privada mejorada con confirmación de saldos, posiciones y diagnóstico automático privado.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
