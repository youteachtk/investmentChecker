{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.6.0",
  "description": "Abre Mi portafolio por su URL real #/portafolio. Reconoce www.retoactinver.com y conserva la sesión para lectura privada.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://www.retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
