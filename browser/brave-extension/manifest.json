{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.8.30",
  "description": "2.8.30: panel independiente persistente para consultar propuestas junto a Actinver.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://www.retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "Abrir panel InvestmentChecker"
  },
  "background": {
    "service_worker": "background.js"
  }
}
