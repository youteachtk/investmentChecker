{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.8.1",
  "description": "Muestra progreso real Acciones/ETFs/Fondos, páginas, contador 0–226, alertas por ausencia de avance y verificación de cotizaciones validadas en GitHub.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://www.retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
