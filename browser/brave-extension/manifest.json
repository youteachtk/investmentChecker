{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.8.4",
  "description": "Restaura el motor de lectura 226/226 probado en Brave, conserva propuestas y aprobación 2.8, y blinda la captura contra cambios accidentales.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://www.retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
