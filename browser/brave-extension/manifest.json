{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.8.8",
  "description": "2.8.8: inspección de V recorre páginas de ACCIONES desde Capitales; conserva cartera y captura de 226 cotizaciones.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://www.retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
