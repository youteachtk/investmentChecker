{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.4.3",
  "description": "Reconoce las tablas diferentes de Acciones/ETFs (10 columnas) y Fondos (9 columnas), incluido precio y rendimientos de fondos.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
