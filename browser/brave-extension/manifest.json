{
  "manifest_version": 3,
  "name": "investmentChecker · Actinver",
  "version": "2.2.2",
  "description": "Una sola sincronización con lectura privada independiente, recuperación lenta de ETFs y navegación automática; nunca opera.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://retoactinver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "investmentChecker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
